      "callees": ["IsGameInMenuState|0x6FB62890", "GetGameContext|0x6FB62880", "InsertCacheNodeWithCookie|0x6FB99C36", "ProcessUIStateChange|0x6FB5D370", "IsGameSystemEnabled|0x6FADB800", "SendResourceUpdate|0x6FB5DB20", "LogFiveBytePacket|0x6FADD280", "SetGlobalValue11103|0x6FB50B50", "ValidateCoordinateInBounds|0x6FB300A0", "GetUIResourceByIdWithValidation|0x6FB5D340", "GetLastError|0x6FB8F780", "ValidateViewportAndSendPacket|0x6FB2F8F0", "GetAlwaysRunSetting|0x6FAD8320", "SetAlwaysRunFlag|0x6FAD8310"],
