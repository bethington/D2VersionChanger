      "api_calls": ["UNITS_GetDirection", "UpdateAnimationModeFromStates", "UNITS_GetDirection", "UpdateAnimationModeFromStates", "UNITS_GetDirection", "UpdateAnimationModeFromStates", "FogAssert", "UNITS_GetDirection", "UpdateAnimationModeFromStates", "FogAssert", "...+5 more"],
