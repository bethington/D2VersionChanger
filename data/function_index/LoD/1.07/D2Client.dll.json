      "globals": ["0xFFFFFFFF9052FFFC||", "0xFFFFFFFF90530000||", "0xFFFFFFFF90530004||", "0xD6098|g_pfnGetTickCount|000dd8c4", "0x1269D0|g_dwLastInteractionTime|0x0", "0x43270|switchdataD_6fb13270|6fb12ffe", "0x128A60|g_dwInteractionState|0x0", "0x128A64|g_dwObjectType|0x0", "0x43294|switchdataD_6fb13294|0x0", "0x43288|switchdataD_6fb13288|6fb1310f", "0x126A00|g_dwInteractionParam1|0x0", "0x1269F8|g_dwInteractionParam0|0x0"],
