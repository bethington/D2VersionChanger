      "callees": ["GetGameContext|0x6FB62880", "GetScrollWindowMode|0x6FAE4FD0", "GfxInterface_CallMethod0x98|0x6FB992F2", "IsInventoryOpen|0x6FB06470", "RenderAutomapObjectsRecursive|0x6FAF82C0"],
