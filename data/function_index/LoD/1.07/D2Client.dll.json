      "callees": ["ValidateCoordinateInBounds|0x6FB300A0", "IsGameInMenuState|0x6FB62890", "GetGameContext|0x6FB62880", "GetLastError|0x6FB8F780", "ProcessPlayerItemState|0x6FB2FE70", "InsertCacheNodeWithCookie|0x6FB99C36", "GetBoxStatsByProperty|0x6FB98A9A", "IsGameSystemEnabled|0x6FADB800", "SendResourceUpdate|0x6FB5DB20", "CopyBeltItemStats|0x6FB98AA6", "LogFiveBytePacket|0x6FADD280"],
