      "strings": ["0x107AB0|s_eUnitClass_<_NUM_MONSTERCLASS_6fbd7ab0|eUnitClass < NUM_MONSTERCLASS", "0x107A78|s_C:\\Projects\\Diablo2\\Source\\D2Cli_6fbd7a78|C:\\Projects\\Diablo2\\Source\\D2Client\\UNIT\\UnitSnd.cpp", "0xF9F40|s_ptUnit_6fbc9f40|ptUnit"],
