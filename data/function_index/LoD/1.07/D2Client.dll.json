      "globals": ["0xFFFFFFFF9052FED4||", "0xFFFFFFFF9053001C||", "0xD5C30|g_pfnUnicodeDefaultCtor|000dd47a", "0xFFFFFFFF90530018||", "0xD5C50|PTR_strncpy_6fba5c50|000dd54a", "0xD5C40|g_pfnUnicodeStrcat|000dd4e0", "0xE6CA4|g_szFormatPercent|0x25", "0xD6210|PTR_wsprintfA_6fba6210|000ddb0c", "0xD5C38|g_pfnUnicodeWin2Unicode|000dd574", "0x12D7FC|g_dwUIXOffset|0x0", "0x12D800|g_dwUIYOffset|0x0"],
