      "callees": ["GetSkillTargetY|0x6FB98512", "UNITS_GetOwnerGuid|0x6FB98122", "SetUnitScrollPos|0x6FB98302", "SetUnitDirectionToTarget|0x6FB984EE", "GetUnitWeaponClass|0x6FB984E2", "FindUnitInHashTable|0x6FB60E10", "SetSkillOwnerType|0x6FB984D0", "CalculateUnitCoordinates|0x6FAE96A0", "GetMonsterResurrectMode|0x6FB98506", "ApplyDamageReduction|0x6FAEB580", "GetSkillsTxtId|0x6FB98338", "UNITS_GetUnitY|0x6FB9811C", "GetMonsterDataField104|0x6FB9850C", "SetSkillTargetX|0x6FB984FA", "GetSkillTargetX|0x6FB98458", "SetSkillTargetY|0x6FB984F4", "GetSkillOwnerType|0x6FB9845E", "InitializeAndAllocateProjectile|0x6FB77720", "UNITS_GetSummonOwnerUnitId|0x6FB983C2", "BuildAndExecuteItemQuery|0x6FAEB480"],
