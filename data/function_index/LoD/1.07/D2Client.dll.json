      "callees": ["CheckAndProcessUnitState|0x6FB79580", "InitializeGameObjectProperties|0x6FB8D210", "FogAssert|0x6FB99A7A", "UNITS_SetStatInfoValue|0x6FB98422", "ClearUnitStateAndProcessTransition|0x6FB86790", "ReportError|0x6FB9A10F", "InitializeOverlayData|0x6FB931F0", "ValidateGameState|0x6FB79550", "InitializeAudioLightingEffect|0x6FAE9BC0"],
