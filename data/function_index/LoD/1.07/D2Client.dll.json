      "globals": ["0xFFFFFFFF9053000C||", "0xFFFFFFFF90530004||", "0xFFFFFFFF90530008||", "0xFFFFFFFF9052FF9C||", "0xFFFFFFFF9052FF98||", "0xFFFFFFFF90530000||", "0xFFFFFFFF90530018||", "0xFFFFFFFF9052FFC0||", "0xD5C30|g_pfnUnicodeDefaultCtor|000dd47a", "0xFFFFFFFF9053001C||", "0xF6358|g_szResourceFormatPlus|0x2b", "0xE0DE4|g_szLocalizationConfig|0x25", "0xD6210|PTR_wsprintfA_6fba6210|000ddb0c", "0xD5C34|g_pfnUnicodeToUnicode|000dd490", "0xD5C40|g_pfnUnicodeStrcat|000dd4e0"],
