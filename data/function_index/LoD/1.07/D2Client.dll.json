      "tags": ["MOD_UI", "STRUCT_Act", "STRUCT_Inventory", "STRUCT_Room2", "STRUCT_ItemData", "SRC_dialog.cpp", "STRUCT_UnitAny", "STRUCT_Control", "STRUCT_PlayerData", "PARAM_7", "STRUCT_Path", "UI_DIALOG", "STRUCT_Skill", "STRUCT_Other"]
