      "strings": ["0xF9EDC|s_C:\\Projects\\Diablo2\\Source\\D2Cli_6fbc9edc|C:\\Projects\\Diablo2\\Source\\D2Client\\UNIT\\CUnit.cpp", "0xFA014|s_!UnitGetFromId(ptUnit->dwId,_ptU_6fbca014|!UnitGetFromId(ptUnit->dwId, ptUnit->eType)", "0xF9F10|s_current_unit_is_%d,_table_is_sup_6fbc9f10|current unit is %d, table is supposed to be %d\n", "0xF9EC4|s_ptUnit->eType_==_eTOU_6fbc9ec4|ptUnit->eType == eTOU", "0xFA040|s_!UnitGetFromClientId(ptUnit->dwI_6fbca040|!UnitGetFromClientId(ptUnit->dwId, ptUnit->eType)"],
      "constant_count": 10,
