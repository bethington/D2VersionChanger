      "constants": ["0xB692F||0x13D3", "0xB69DC||0x2AE", "0xB6A05||0x141", "0xB6A0D||0x149", "0xB6A15||0x14F", "0xB6A1D||0x155", "0xB6A25||0x15B", "0xB6A2D||0x145", "0xB6A5C||0x161", "0xB6A72||0x167", "0xB6A92||0x16A", "0xB6AB3||0x16A", "0xB6ACC||0x170", "0xB6AE3||0x178", "0xB6AFF||0x178", "0xB6B1C||0x178", "0xB6B31||0x17B", "0xB6B41||0x17E", "0xB6B51||0x18B", "0xB6B61||0x956", "0xB6B6E||0x187"],
