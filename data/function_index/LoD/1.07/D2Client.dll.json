      "globals": ["0xFFFFFFFF90530000||", "0xFFFFFFFF9053001C||", "0xFFFFFFFF90530004||", "0xD6FF4|g_SkillEventTable|-0x1", "0xD6FF8|DAT_6fba6ff8|0x0"],
