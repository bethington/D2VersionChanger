      "globals": ["0xFFFFFFFF90530000||", "0xDE0E8|g_dwScreenHeight|0x1e0", "0xDE0E4|g_dwScreenWidth|0x280", "0x10C018|g_dwGraphicsQualityFlag|0x0", "0x10C014|g_dwBackBufferHeight|0x0", "0x10C010|g_dwViewportHeight|0x0", "0xDE0EC|g_dwBackBufferWidth|0x280"],
