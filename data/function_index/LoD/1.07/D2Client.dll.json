      "globals": ["0x119284|g_hRenderContext|0x0", "0xFFFFFFFF90530000||", "0x1242A0|g_pActiveAutomapLevelNode|0x0", "0x12431C|g_dwAutomapLeftState|0x0", "0x124320|g_dwAutomapLeftPrevious|0x0", "0x124324|g_dwAutomapLeftTarget|0x0", "0x12428C|g_dwLastError|0x0", "0xDE0E4|g_dwScreenWidth|0x280", "0xE1D10|g_dwSubtileDivisor|0xa", "0x10C014|g_dwBackBufferHeight|0x0", "0x10C010|g_dwViewportHeight|0x0", "0x1242CC|DAT_6fbf42cc|0x0", "0x1242C4|g_dwWindowBorderX|0x0", "0x1242D0|DAT_6fbf42d0|0x0", "0x1242C8|g_dwWindowBorderY|0x0", "0x1242D4|g_nAutomapOriginX|0x0", "0x1242D8|g_nAutomapOriginY|0x0", "0x1242A4|DAT_6fbf42a4|0x0", "0xFFFFFFFF9052FFF4||", "0xFFFFFFFF9052FFE4||"],
