      "api_calls": ["ParseItemDataFromBitstream", "FogAssert", "FogAssert", "GetUnitExtendedStat", "UNITS_MaskFlags", "SetInventoryField0x18", "INVENTORY_GetOwner", "INVENTORY_GetOwner", "GetStatListByKey", "SetUnitStateFlag", "...+3 more"],
