      "globals": ["0x10C018|g_dwGraphicsQualityFlag|0x0", "0xFFFFFFFF9052FEF8||", "0xE7548|g_dwGameMode|0x2", "0xFFFFFFFF90530018||", "0xFFFFFFFF9052FEFC||", "0xFFFFFFFF90530008||", "0xFFFFFFFF90530004||", "0xFFFFFFFF9052FEE8||", "0xFFFFFFFF9052FEEC||", "0xFFFFFFFF9052FEF0||", "0xFFFFFFFF9052FEF4||", "0xFFFFFFFF90530000||", "0x12901C|g_dwMonsterVisible|0x0", "0xE7550|g_dwSelectedMonsterIndex|-0x1", "0x129034|g_bUnitSelected|0x0", "0x129030|g_dwFadeEndTime|0x0", "0xE7554|g_nSelectedItemSlot|-0x1", "0xE7558|g_hDisplayWindow|-0x1"],
