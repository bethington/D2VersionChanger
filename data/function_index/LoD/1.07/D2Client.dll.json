      "globals": ["0x1266D4|g_dwButtonGridState1|0x0", "0x1266D8|g_dwButtonGridState2|0x0", "0xFFFFFFFF90530004||", "0xFFFFFFFF9053001C||", "0x1262A4|g_adwButtonBoundsArray|0x0", "0xFFFFFFFF90530014||", "0x1262A0|DAT_6fbf62a0|0x0", "0x1262B5|DAT_6fbf62b5|0x0", "0x1262B9|DAT_6fbf62b9|0x0", "0x126361|DAT_6fbf6361|0x0", "0x1262B1|g_adwButtonDataTable|0x0", "0x1262C6|DAT_6fbf62c6|0x0", "0x1262A8|g_abButtonValueTable|0x0", "0x1262BD|DAT_6fbf62bd|0x0", "0x1266D0|g_dwSelectedButtonColumn|0x0", "0x125F62|g_abButtonStateArray|0x0", "0xFFFFFFFF90530000||", "0x125F68|DAT_6fbf5f68|0x0", "0x125F82|DAT_6fbf5f82|0x0", "0x125F7C|DAT_6fbf5f7c|0x0"],
