      "globals": ["0x12428C|g_dwLastError|0x0", "0xE1D10|g_dwSubtileDivisor|0xa", "0x1242C4|g_dwWindowBorderX|0x0", "0x1242C8|g_dwWindowBorderY|0x0", "0xDE0E4|g_dwScreenWidth|0x280", "0xDE0E8|g_dwScreenHeight|0x1e0", "0x124318|g_dwWindowBaseX|0x0", "0x124314|g_dwWindowBaseY|0x0"],
      "api_count": 0,
