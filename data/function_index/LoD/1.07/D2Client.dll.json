      "callee_count": 9,
      "callees": ["GetMonsterBaseId|0x6FB98518", "CreateAudioContext|0x6FAD41F0", "CalculateUnitCoordinates|0x6FAE96A0", "SetLightRadius|0x6FAD42F0", "MissileSetField18|0x6FB98542", "ClearAudioContextReference|0x6FB637A0", "GetMonsterDataFieldF0|0x6FB98524", "MISSILE_SetTargetX|0x6FB9853C", "InitializeAndAllocateProjectile|0x6FB77720"],
